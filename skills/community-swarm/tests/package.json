{
  "name": "community-swarm-validation",
  "version": "1.0.0",
  "description": "Agent 10 Validation Framework for Community Swarm",
  "main": "validation-suite.ts",
  "scripts": {
    "test": "jest",
    "test:unit": "jest --testNamePattern='Evidence|Communication|Delegation|Hook'",
    "test:integration": "jest --testNamePattern='Integration'",
    "test:stress": "jest --testNamePattern='Stress'",
    "test:evidence-compliance": "jest --testNamePattern='Evidence'",
    "test:orchestrator-delegation": "jest --testNamePattern='Orchestrator'",
    "test:hooks": "jest --testNamePattern='Hook'",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:full-swarm": "jest --testNamePattern='Full.*[Ss]warm'",
    "test:compliance": "jest --testNamePattern='Compliance'",
    "test:quick": "jest --testNamePattern='Evidence|Delegation' --bail",
    "monitor:messages": "node scripts/monitor-messages.js",
    "analyze:hooks": "node scripts/analyze-hooks.js",
    "validate": "./run-validation.sh",
    "report": "./run-validation.sh --report-only"
  },
  "keywords": [
    "validation",
    "testing",
    "swarm",
    "multi-agent",
    "orchestration",
    "evidence-based",
    "community"
  ],
  "author": "Agent 10",
  "license": "MIT",
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>"
    ],
    "testMatch": [
      "**/*.test.ts",
      "**/*.spec.ts",
      "**/validation-suite.ts"
    ],
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.d.ts",
      "!**/node_modules/**",
      "!**/reports/**",
      "!**/logs/**"
    ],
    "coverageThresholds": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "testTimeout": 60000,
    "maxWorkers": 4,
    "verbose": true,
    "bail": false,
    "clearMocks": true,
    "restoreMocks": true,
    "errorOnDeprecated": true,
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "./reports",
          "outputName": "junit.xml",
          "ancestorSeparator": " › ",
          "uniqueOutputName": "false",
          "suiteNameTemplate": "{filepath}",
          "classNameTemplate": "{classname}",
          "titleTemplate": "{title}"
        }
      ]
    ]
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "jest-junit": "^16.0.0"
  }
}